.game{min-height:100vh;display:grid;grid-template-columns:68% 1fr;grid-template-rows:100rpx 1fr;gap:22rpx;overflow-y:auto}.game-head{grid-column:1/-1;display:grid;grid-template-columns:90rpx 1fr 90rpx;align-items:center}.icon-button{width:82rpx;height:82rpx;padding:0;border-radius:27rpx;background:#ffffffbb;color:#554d64;font-size:46rpx}.progress-title{text-align:center;font-size:27rpx;font-weight:700}.progress{height:12rpx;margin:12rpx auto 0;width:55%;border-radius:20rpx;background:#ffffffb5;overflow:hidden}.progress-fill{height:100%;background:#75649b}.visual-panel{min-height:0;display:flex;flex-direction:column;align-items:center}.type-tag{padding:9rpx 18rpx;border-radius:20rpx;background:#ebe5f2;color:#68578a;font-size:22rpx;font-weight:700}.prompt{margin-top:10rpx;font-size:28rpx;font-weight:650}.object-stage{position:relative;flex:1;width:100%;display:flex;align-items:center;justify-content:center;gap:24rpx}.plate{position:absolute;bottom:30rpx;width:520rpx;height:52rpx;border:5rpx solid #fff;border-radius:50%;background:#ffffff80}.objects{z-index:2;max-width:260rpx;display:flex;flex-wrap:wrap;justify-content:center;font-size:63rpx;line-height:1}.objects.wide{max-width:360rpx}.objects.removed{max-width:210rpx;opacity:.38;filter:grayscale(.5)}.plus{z-index:2;font-size:55rpx;font-weight:800}.take-arrow{z-index:2;color:#74677b;font-size:23rpx;font-weight:700}.equation{margin:4rpx 0 15rpx;font-size:60rpx;font-weight:800;letter-spacing:7rpx}.equation text{color:#6b588f}.answer-panel{display:flex;min-height:0;flex-direction:column;justify-content:center;padding-right:10rpx}.answers{display:grid;gap:17rpx}.answer{min-height:120rpx;border:3rpx solid transparent;border-radius:34rpx;background:#ffffffdc;color:#514a62;font-size:55rpx;font-weight:800}.answer.correct{border-color:#668d74;background:#e5f1e8;color:#3e6d50}.coach{min-height:80rpx;margin-top:18rpx;text-align:center;color:#696272;font-size:25rpx;line-height:1.5}.help{min-height:90rpx;background:transparent;color:#675b77;font-size:27rpx;font-weight:650}.mask{position:fixed;z-index:100;inset:0;display:flex;align-items:center;justify-content:center;padding:40rpx;background:#39334466}.exit-card{width:680rpx;max-width:58vw;padding:40rpx;text-align:center;box-sizing:border-box}.exit-icon{font-size:60rpx}.exit-title{font-size:38rpx;font-weight:750}.exit-text{margin:8rpx 0 26rpx;color:#77717e;font-size:25rpx}.exit-card .secondary{margin-top:14rpx}
