<view class="safe-page game device-{{deviceType}}"><view class="game-head capsule-safe"><button class="icon-button" bindtap="askExit">‹</button><view class="progress-title">第 {{current}} 题 / 5<view class="progress"><view class="progress-fill" style="width:{{progressWidth}}%"></view></view></view><button class="icon-button audio" bindtap="replay">🔊</button></view><view class="visual-panel"><view class="type-tag">{{question.operation === 'addition' ? '合起来 · 加法' : '拿走后 · 减法'}}</view><view class="prompt">小兔有 {{question.left}} 根，{{question.actionText}} {{question.right}} 根</view><view class="object-stage" wx:if="{{question.operation === 'addition'}}"><view class="plate"></view><view class="objects"><text wx:for="{{leftItems}}" wx:key="*this">🥕</text></view><view class="plus">＋</view><view class="objects"><text wx:for="{{rightItems}}" wx:key="*this">🥕</text></view></view><view class="object-stage subtract-stage" wx:else><view class="plate"></view><view class="objects wide"><text wx:for="{{remainingItems}}" wx:key="*this">🥕</text></view><view class="take-arrow">拿走 →</view><view class="objects removed"><text wx:for="{{removedItems}}" wx:key="*this">🥕</text></view></view><view class="equation">{{question.left}} {{question.symbol}} {{question.right}} ＝ <text>{{showEquationAnswer ? question.answer : '?'}}</text></view></view><view class="answer-panel"><view class="answers"><button wx:for="{{question.options}}" wx:key="*this" class="answer {{selectedAnswer===item && showEquationAnswer?'correct':''}}" data-value="{{item}}" bindtap="chooseAnswer">{{item}}</button></view><view class="coach">{{coach}}</view><button class="help" bindtap="useHelp">💡 帮帮我</button></view></view>
<view class="mask device-{{deviceType}}" wx:if="{{showExit}}"><view class="exit-card card"><view class="exit-icon">🌿</view><view class="exit-title">休息一下？</view><view class="exit-text">现在的进度会为你保留。</view><button class="primary" bindtap="closeExit">继续游戏</button><button class="secondary" bindtap="confirmExit">退出游戏</button></view></view><orientation-guard/><rest-overlay/>
