.split-page{min-height:100vh;overflow-y:auto}.header{display:flex;align-items:center;gap:22rpx}.back{width:88rpx;height:88rpx;padding:0;border-radius:29rpx;background:#fff9;color:#554d62;font-size:52rpx}.title{font-size:36rpx;font-weight:800}.target{margin-left:auto;margin-right:200rpx;font-size:30rpx;font-weight:700}.target text{color:#75649b;font-size:55rpx}.round{color:#77707e}.source-zone{height:235rpx;text-align:center}.feedback{height:55rpx;color:#655d6d;font-size:29rpx;font-weight:700}.source-blocks{display:flex;align-items:center;justify-content:center;gap:15rpx}.block{width:92rpx;height:92rpx;display:flex;align-items:center;justify-content:center;border-radius:27rpx;background:#fff;font-size:55rpx;touch-action:none;box-sizing:border-box}.block.c0{background:#ebe2f1}.block.c1{background:#e2efe7}.block.c2{background:#e1edf1}.block.c3{background:#f1e5d7}.block.dragging{opacity:.88}.baskets{height:calc(100vh - 355rpx);display:grid;grid-template-columns:1fr 80rpx 1fr;align-items:center;gap:20rpx}.basket{height:100%;min-height:0;padding:24rpx;border:5rpx dashed #9a8dad66;border-radius:45rpx;background:#ffffff70;box-sizing:border-box;overflow:hidden}.basket-title{text-align:center;color:#665d6e;font-size:28rpx;font-weight:700}.basket-title text{font-size:43rpx}.basket-blocks{display:flex;align-content:center;justify-content:center;flex-wrap:wrap;gap:12rpx;height:calc(100% - 50rpx);overflow:hidden}.basket .block{width:82rpx;height:82rpx;font-size:48rpx}.plus{text-align:center;font-size:55rpx;font-weight:800}.complete-mask{position:fixed;z-index:100;inset:0;display:flex;align-items:center;justify-content:center;background:#39334475}.complete{width:720rpx;max-width:60vw;padding:45rpx;text-align:center;box-sizing:border-box}.big{font-size:82rpx}.complete-title{font-size:40rpx;font-weight:800}.complete-text{margin:14rpx 0 28rpx;color:#776f7d;font-size:27rpx}.complete .secondary{margin-top:15rpx}
