<view class="safe-page parent-page device-{{deviceType}}">
  <view class="intro capsule-safe"><button class="back" bindtap="back">‹</button><view class="intro-icon">🌿</view><view><view class="title">家长中心</view><view class="muted">了解学习情况，设置合适节奏</view></view></view>
  <view class="stats"><view class="card stat"><text>{{progress.sessionsCompleted}}</text><view>累计完成局数</view></view><view class="card stat"><text>{{progress.stars}}</text><view>累计星星</view></view></view>
  <view class="card report"><view class="section-title">最近 20 题</view><view class="metrics"><view><text>{{summary.accuracy}}%</text><label>首次正确率</label></view><view><text>{{summary.hintRate}}%</text><label>提示使用率</label></view></view><view class="operation-metrics"><text>加法正确率 {{summary.additionAccuracy}}%</text><text>减法正确率 {{summary.subtractionAccuracy}}%</text></view><view class="advice">💡 {{summary.advice}}</view></view>
  <view class="card settings"><view class="section-title">学习设置</view><view class="setting-row"><text>题目语音</text><switch checked="{{settings.voiceOn}}" color="#75649b" bindchange="toggleVoice" /></view><view class="setting-row"><text>背景音乐</text><switch checked="{{settings.musicOn}}" color="#75649b" bindchange="toggleMusic" /></view><view class="daily-label">每日建议局数</view><view class="daily-options"><button wx:for="{{dailyOptions}}" wx:key="*this" data-value="{{item}}" class="daily-button {{settings.dailySessions===item?'selected':''}}" bindtap="setDaily">{{item}} 局</button></view></view>
  <view class="privacy">所有学习记录只保存在本机。清除后无法恢复。</view><button class="clear" bindtap="askClear">清除学习记录</button>
</view><orientation-guard/>
<view class="mask device-{{deviceType}}" wx:if="{{showClear}}"><view class="confirm card"><view class="confirm-title">确定清除学习记录？</view><view class="muted">星星、局数和答题记录都会清除，孩子昵称会保留。</view><button class="danger" bindtap="clearData">确定清除</button><button class="secondary" bindtap="cancelClear">暂不清除</button></view></view>
