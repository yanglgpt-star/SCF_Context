page { background: #f7f2e9; color: #4e485d; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 30rpx; }
button { font: inherit; }
button::after { border: 0; }
.safe-page { width:100%; max-width:1200px; min-height:100vh; margin:0 auto; box-sizing:border-box; padding:calc(28rpx + env(safe-area-inset-top)) 48rpx calc(34rpx + env(safe-area-inset-bottom)); background:linear-gradient(155deg,#faf4eb 0%,#f2edf6 56%,#edf5f3 100%); }
.capsule-safe { min-height:88rpx; padding-right:220rpx; box-sizing:border-box; }
.card { background: rgba(255,255,255,.82); border: 2rpx solid rgba(119,102,151,.14); border-radius: 40rpx; box-shadow: 0 12rpx 36rpx rgba(68,59,87,.06); }
.primary { min-height: 104rpx; display: flex; align-items: center; justify-content: center; border-radius: 30rpx; background: #75649b; color: #fff; font-size: 36rpx; font-weight: 700; box-shadow: 0 10rpx 24rpx rgba(90,74,125,.18); }
.primary:active { opacity: .88; }
.secondary { min-height: 92rpx; display:flex; align-items:center; justify-content:center; border-radius: 28rpx; background: #eee8f3; color: #5c506e; font-weight: 650; }
.muted { color: #777180; }
@media (min-width: 1000px) { .safe-page { padding-left:64px; padding-right:64px; } }
@media (max-height:600px) and (orientation:landscape) {
  .safe-page{padding:12rpx 24rpx calc(18rpx + env(safe-area-inset-bottom))}
  .capsule-safe{min-height:70rpx;padding-right:190rpx}
  .card{border-radius:30rpx}
  .primary{min-height:90rpx;border-radius:26rpx;font-size:31rpx}
  .secondary{min-height:80rpx;font-size:27rpx}
  page .topbar{min-height:62rpx}
  page .avatar{width:64rpx;height:64rpx;border-radius:22rpx;font-size:36rpx}
  page .profile{font-size:27rpx}
  page .harvest{min-height:56rpx;padding:0 18rpx;font-size:22rpx}
  page .landscape-main{gap:18rpx;margin-top:10rpx;padding-bottom:82rpx}
  page .recommend{padding:20rpx}
  page .tag{padding:6rpx 12rpx;font-size:19rpx}
  page .recommend-title{margin:10rpx 0 4rpx;font-size:31rpx}
  page .recommend-meta{font-size:21rpx}
  page .recommend-scene{font-size:48rpx}
  page .progress-dots{margin-bottom:8rpx}
  page .section-head{margin-bottom:8rpx}
  page .section-title{font-size:29rpx}
  page .listen{width:58rpx;height:58rpx;border-radius:20rpx;font-size:25rpx}
  page .modules{gap:10rpx}
  page .module{gap:12rpx;padding:15rpx;border-radius:27rpx}
  page .module-icon{font-size:47rpx}
  page .module-title{font-size:25rpx}
  page .module-state{margin-top:3rpx;font-size:18rpx}
  page .module-badge{top:8rpx;right:10rpx;font-size:15rpx}
  page .bottom-nav{gap:90rpx;padding-top:7rpx;padding-bottom:calc(7rpx + env(safe-area-inset-bottom))}
  page .bottom-icon{font-size:27rpx}
  page .bottom-item{font-size:16rpx}
  page .header{gap:14rpx}
  page .header .back{width:68rpx;height:68rpx;border-radius:23rpx;font-size:42rpx}
  page .header .title{font-size:29rpx}
  page .header .round{font-size:19rpx}
  page .content,page .game-area{min-height:330px;height:auto;gap:18rpx;padding-bottom:18rpx}
  page .object-card{padding:18rpx}
  page .tip,page .feedback{font-size:24rpx}
  page .objects{gap:12rpx}
  page .object{width:120rpx;height:120rpx;font-size:58rpx}
  page .answers{gap:10rpx}
  page .answers button,page .answer{min-height:120rpx;font-size:45rpx;border-radius:27rpx}
  page .source-zone{height:180rpx}
  page .source-blocks{gap:8rpx}
  page .block{width:82rpx;height:82rpx;font-size:45rpx}
  page .baskets{min-height:280px;height:auto}
  page .basket{border-radius:32rpx;padding:15rpx}
  page .basket .block{width:72rpx;height:72rpx;font-size:40rpx}
  page .target{font-size:24rpx}
  page .target text{font-size:42rpx}
  page .game{grid-template-rows:75rpx minmax(320px,1fr);gap:10rpx}
  page .game-head{grid-template-columns:70rpx 1fr 70rpx}
  page .icon-button{width:65rpx;height:65rpx;font-size:38rpx}
  page .type-tag{font-size:18rpx}
  page .prompt{font-size:23rpx}
  page .objects{font-size:52rpx}
  page .equation{font-size:48rpx}
  page .coach{font-size:22rpx}
  page .help{min-height:72rpx;font-size:23rpx}
  page .die{font-size:150rpx}
  page .roll{min-width:320rpx;min-height:96rpx;font-size:30rpx}
  page .result{min-height:420px;padding-top:12rpx}
  page .result .rabbit{font-size:135rpx}
  page .result .title{font-size:37rpx}
  page .parent-page{gap:12rpx;padding-bottom:20rpx}
}

