/* 页面根节点之外的弹窗必须自行绑定 device-phone。 */
.setup-mask.device-phone,.complete-mask.device-phone,.mask.device-phone{padding:8px calc(100px + env(safe-area-inset-right)) 8px calc(12px + env(safe-area-inset-left));box-sizing:border-box;overflow-y:auto}
.setup-mask.device-phone .setup{width:720px;max-width:100%;max-height:calc(100vh - 16px);padding:12px 16px;border-radius:16px;box-sizing:border-box;overflow-y:auto}
.setup-mask.device-phone .setup-icon{font-size:24px;line-height:1}
.setup-mask.device-phone .setup-title{margin:2px 0 8px;font-size:20px}
.setup-mask.device-phone .setup-row{grid-template-columns:1fr 1fr;gap:18px}
.setup-mask.device-phone .setup-label{margin:3px 0 7px;font-size:14px}
.setup-mask.device-phone .avatar-list{gap:8px}
.setup-mask.device-phone .avatar-choice{width:58px;height:58px;border-width:3px;border-radius:16px;font-size:30px;box-sizing:border-box}
.setup-mask.device-phone .name-input{height:44px;padding:0 12px;border-radius:12px;font-size:17px}
.setup-mask.device-phone .privacy{margin:6px 0;font-size:11px}
.setup-mask.device-phone .name-side .primary{min-height:44px;font-size:16px}
.complete-mask.device-phone .complete,.mask.device-phone .exit-card,.mask.device-phone .confirm{width:420px;max-width:62vw;padding:16px 20px;border-radius:16px;box-sizing:border-box}
.complete-mask.device-phone .big,.mask.device-phone .exit-icon{font-size:36px;line-height:1}
.complete-mask.device-phone .complete-title,.mask.device-phone .exit-title,.mask.device-phone .confirm-title{font-size:20px}
.complete-mask.device-phone .complete-text,.mask.device-phone .exit-text,.mask.device-phone .muted{margin:5px 0 10px;font-size:13px}
.complete-mask.device-phone .secondary,.mask.device-phone .secondary{margin-top:6px;min-height:42px}
.mask.device-phone .danger{min-height:42px;margin:10px 0 6px;border-radius:13px;font-size:14px}

/* 各学习页手机横屏内容密度复核。 */
.count-page.device-phone .content{grid-template-columns:74% 1fr}
.count-page.device-phone .objects.few .object{width:96px;height:96px;font-size:50px}
.count-page.device-phone .objects.medium .object{width:82px;height:82px;font-size:43px}
.count-page.device-phone .objects.dense .object{width:70px;height:70px;font-size:37px}
.count-page.device-phone .waiting{font-size:42px}
.split-page.device-phone .source-zone{height:92px}
.split-page.device-phone .source-zone .feedback{height:28px;min-height:28px;line-height:28px}
.split-page.device-phone .source-blocks{height:58px;align-items:center;overflow:visible}
.split-page.device-phone .baskets{box-sizing:border-box;align-items:stretch}
.split-page.device-phone .basket{height:100%;min-height:0;box-sizing:border-box;overflow:hidden}
.split-page.device-phone .basket-title{font-size:14px}.split-page.device-phone .basket-title text{font-size:22px}
.split-page.device-phone .basket-blocks{height:calc(100% - 28px);gap:6px;overflow:hidden}
.split-page.device-phone .plus,.dice-page.device-phone .plus{font-size:34px}
.dice-page.device-phone .feedback{min-height:50px;font-size:14px}
.game.device-phone .take-arrow{font-size:13px}.game.device-phone .plus{font-size:30px}
.result.device-phone .rest{left:22px;bottom:75px;font-size:12px}
.parent-page.device-phone .intro{gap:9px}.parent-page.device-phone .intro .muted{font-size:12px}
.parent-page.device-phone .stats{gap:7px}.parent-page.device-phone .stat{padding:10px;font-size:12px}.parent-page.device-phone .stat text{font-size:22px}
.parent-page.device-phone .report,.parent-page.device-phone .settings{padding:13px}.parent-page.device-phone .section-title{margin-bottom:8px;font-size:15px}
.parent-page.device-phone .metrics text{font-size:22px}.parent-page.device-phone .metrics label{font-size:11px}
.parent-page.device-phone .operation-metrics{margin-top:8px;padding:7px;border-radius:10px;font-size:11px}
.parent-page.device-phone .advice{margin-top:7px;padding:8px;border-radius:10px;font-size:12px}
.parent-page.device-phone .setting-row{min-height:38px}.parent-page.device-phone .daily-label{margin:8px 0 6px;font-size:13px}
.parent-page.device-phone .daily-options{gap:6px}.parent-page.device-phone .daily-button{min-height:36px;border-radius:11px;font-size:12px}
.parent-page.device-phone .privacy{font-size:11px}.parent-page.device-phone .clear{font-size:13px}
