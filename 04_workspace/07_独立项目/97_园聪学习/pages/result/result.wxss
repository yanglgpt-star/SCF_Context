.result{min-height:100vh;display:grid;grid-template-columns:45% 1fr;grid-template-rows:auto auto 1fr auto;column-gap:45rpx;align-items:center;text-align:center;padding-top:40rpx}.confetti{grid-column:1;font-size:55rpx}.rabbit{grid-column:1;grid-row:2/4;font-size:190rpx}.title{grid-column:2;grid-row:1;font-size:48rpx;font-weight:800}.subtitle{grid-column:2;grid-row:2;color:#746e7a;font-size:28rpx}.reward{grid-column:2;width:100%;padding:28rpx;font-size:37rpx;font-weight:800}.stats{grid-column:2;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.stat{padding:22rpx;color:#706a76;font-size:23rpx}.stat text{display:block;color:#514a62;font-size:44rpx;font-weight:800}.total{grid-column:2;color:#665f6e;font-size:25rpx}.result .primary{grid-column:1;width:100%}.again{grid-column:2;grid-row:4;min-height:100rpx;border-radius:30rpx;background:#ece6ef;color:#665a76;font-size:28rpx}.rest{position:absolute;left:45rpx;bottom:150rpx;color:#728079;font-size:22rpx}
