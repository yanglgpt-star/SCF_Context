.orientation-mask{position:fixed;z-index:9999;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#f6f0e9;color:#554d62}.rotate{font-size:130rpx;animation:turn 1.8s ease-in-out infinite}.title{margin-top:24rpx;font-size:48rpx;font-weight:800}.text{margin-top:16rpx;color:#766f7d;font-size:30rpx}.orientation-mask.phone .rotate{font-size:64px}.orientation-mask.phone .title{margin-top:12px;font-size:24px}.orientation-mask.phone .text{margin-top:8px;font-size:15px}@keyframes turn{50%{transform:rotate(90deg)}}
