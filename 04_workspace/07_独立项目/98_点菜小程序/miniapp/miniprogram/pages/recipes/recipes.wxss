/* 菜谱库样式 */

.page-recipes {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  gap: 16rpx;
}
.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 50rpx;
  padding: 0 24rpx;
  height: 72rpx;
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 72rpx;
}
.search-clear {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx;
}
.search-filter {
  font-size: 28rpx;
  color: #666;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
}
.search-filter.active {
  color: #07c160;
  background: #e8f8ee;
}

/* 筛选面板 */
.filter-panel {
  background: #fff;
  padding: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}
.filter-section {
  margin-bottom: 20rpx;
}
.filter-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}
.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.filter-tag {
  padding: 8rpx 24rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
}
.filter-tag.active {
  background: #e8f8ee;
  color: #07c160;
}
.filter-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}
.filter-btn {
  padding: 12rpx 40rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
}
.filter-btn.cancel {
  background: #f5f5f5;
  color: #666;
}
.filter-btn.confirm {
  background: #07c160;
  color: #fff;
}

/* 分类 Tab */
.category-tabs {
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}
.category-list {
  display: flex;
  gap: 12rpx;
}
.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
  min-width: 80rpx;
}
.category-item.active {
  background: #e8f8ee;
}
.category-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}
.category-name {
  font-size: 22rpx;
  color: #666;
}
.category-item.active .category-name {
  color: #07c160;
  font-weight: 500;
}

/* 菜品卡片 */
.dish-list {
  padding: 16rpx 20rpx;
}
.dish-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  align-items: center;
}
.dish-info {
  flex: 1;
  min-width: 0;
}
.dish-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}
.dish-meta {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 8rpx;
}
.stars {
  color: #fa8c16;
  font-size: 24rpx;
}
.calories, .cook-time {
  font-size: 22rpx;
  color: #999;
}
.dish-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}
.dish-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-left: 20rpx;
  flex-shrink: 0;
}
.dish-image image {
  width: 100%;
  height: 100%;
}
.empty-hint {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 12rpx;
}
