<!-- 菜谱库页面 -->
<view class="page-recipes">

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索菜名..."
        value="{{keyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search" />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="onSearchClear">✕</text>
    </view>
    <text class="search-filter {{showFilter ? 'active' : ''}}" bindtap="toggleFilter">筛选</text>
  </view>

  <!-- 筛选面板 -->
  <view class="filter-panel" wx:if="{{showFilter}}">
    <view class="filter-section">
      <text class="filter-label">餐次</text>
      <view class="filter-options">
        <text class="filter-tag {{filters.mealType === '早餐' ? 'active' : ''}}"
          data-type="mealType" data-value="早餐" bindtap="setFilter">早餐</text>
        <text class="filter-tag {{filters.mealType === '午餐' ? 'active' : ''}}"
          data-type="mealType" data-value="午餐" bindtap="setFilter">午餐</text>
        <text class="filter-tag {{filters.mealType === '晚餐' ? 'active' : ''}}"
          data-type="mealType" data-value="晚餐" bindtap="setFilter">晚餐</text>
        <text class="filter-tag {{filters.mealType === '下午茶' ? 'active' : ''}}"
          data-type="mealType" data-value="下午茶" bindtap="setFilter">下午茶</text>
      </view>
    </view>
    <view class="filter-actions">
      <text class="filter-btn cancel" bindtap="toggleFilter">取消</text>
      <text class="filter-btn confirm" bindtap="applyFilter">确定</text>
    </view>
  </view>

  <!-- 分类 Tab -->
  <scroll-view class="category-tabs" scroll-x enable-flex>
    <view class="category-list">
      <view class="category-item {{activeCategory === cat.key ? 'active' : ''}}"
        wx:for="{{categories}}" wx:key="key"
        data-category="{{item.key}}"
        bindtap="onCategoryChange">
        <text class="category-icon">{{item.icon}}</text>
        <text class="category-name">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 菜品列表 -->
  <view class="dish-list">
    <view class="dish-card"
      wx:for="{{dishes}}" wx:key="_id"
      data-id="{{item._id || item.name}}"
      bindtap="goDetail">
      <view class="dish-info">
        <text class="dish-name">{{item.name}}</text>
        <view class="dish-meta">
          <text class="stars">{{renderStars(item.difficulty)}}</text>
          <text class="calories">{{item.calories || '?'}}大卡</text>
          <text class="cook-time">{{item.cook_time || '?'}}分钟</text>
        </view>
        <view class="dish-tags">
          <text class="tag tag-green" wx:if="{{item.isMeat}}">荤</text>
          <text class="tag tag-orange" wx:if="{{!item.isMeat}}">素</text>
          <text class="tag tag-blue" wx:for="{{item.meal_type || []}}" wx:key="*this">{{item}}</text>
          <text class="tag tag-purple" wx:for="{{item.taste || []}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
      <!-- 云存储图片 -->
      <view class="dish-image" wx:if="{{(item.images && item.images.length > 0 && item.images[0].indexOf('cloud://') === 0) || (item.images_url && item.images_url.indexOf('cloud://') === 0)}}">
        <image src="{{item.images_url || item.images[0]}}" mode="aspectFill" />
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{dishes.length === 0 && !loading}}">
      <text>🍽️ 暂无菜品</text>
      <text class="empty-hint">试试其他分类或搜索</text>
    </view>

    <!-- 加载更多 -->
    <view class="loading-more" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </view>

</view>
