/* 首页-餐馆点菜风格 */
.page-order {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* ====== 搜索栏 ====== */
.search-bar {
  padding: 16rpx 20rpx;
  background: #fff;
  flex-shrink: 0;
}
.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 50rpx;
  padding: 0 24rpx;
  height: 72rpx;
}
.search-icon { font-size: 28rpx; margin-right: 12rpx; }
.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 72rpx;
}
.search-clear {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx;
}

/* ====== 分类标签 ====== */
.category-bar {
  background: #fff;
  padding: 12rpx 0 16rpx;
  flex-shrink: 0;
  border-bottom: 2rpx solid #f0f0f0;
}
.category-list {
  display: flex;
  padding: 0 16rpx;
  gap: 12rpx;
  white-space: nowrap;
}
.category-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  flex-shrink: 0;
}
.category-item.active {
  background: #07c160;
  color: #fff;
  font-weight: 500;
}
.cat-count {
  font-size: 20rpx;
  opacity: 0.7;
}

/* ====== 菜品网格 ====== */
.dish-scroll {
  flex: 1;
  overflow-y: scroll;
  -webkit-overflow-scrolling: touch;
}
.dish-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 16rpx 20rpx 120rpx;
}
.dish-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  position: relative;
}
.card-banner {
  height: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background: #f0f0f0;
}
.card-img {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0; left: 0;
}
.banner-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}
.banner-meat .banner-fallback { background: linear-gradient(135deg, #ff6b6b, #ee5a24); }
.banner-veg .banner-fallback { background: linear-gradient(135deg, #2ed573, #05a34a); }
.banner-icon {
  font-size: 52rpx;
  margin-bottom: 6rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0,0,0,0.2));
}
.banner-title {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 500;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.2);
}
.card-body {
  padding: 10rpx 12rpx;
}
.card-tags {
  display: flex;
  gap: 6rpx;
  flex-wrap: wrap;
}
.card-add {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.9);
  color: #07c160;
  text-align: center;
  line-height: 46rpx;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
}
.card-add.in-cart {
  background: #07c160;
  color: #fff;
}

/* tag 共用 */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  line-height: 1.6;
}
.tag-green { background: #e8f8ee; color: #07c160; }
.tag-orange { background: #fff7e6; color: #fa8c16; }
.tag-gray { background: #f5f5f5; color: #999; }

/* ====== 底部购物车栏 ====== */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  z-index: 50;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.cart-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.cart-icon-wrap {
  position: relative;
}
.cart-icon { font-size: 44rpx; }
.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -12rpx;
  background: #ff4757;
  color: #fff;
  font-size: 20rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 32rpx;
}
.cart-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.cart-view-btn {
  background: #07c160;
  color: #fff;
  padding: 14rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 500;
}

/* ====== 购物车弹窗 ====== */
.cart-overlay {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
}
.cart-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}
.cart-title { font-size: 30rpx; font-weight: 600; color: #333; }
.cart-close { font-size: 32rpx; color: #999; padding: 8rpx; }
.cart-list {
  flex: 1;
  overflow-y: scroll;
  max-height: 500rpx;
  padding: 0 24rpx;
}
.cart-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}
.cart-item-left { flex: 1; }
.cart-item-name { font-size: 28rpx; color: #333; display: block; }
.cart-item-meta { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }
.cart-remove {
  font-size: 24rpx;
  color: #ff4757;
  padding: 8rpx 16rpx;
}
.cart-actions {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-top: 2rpx solid #f0f0f0;
}
.cart-clear {
  flex: 0 0 140rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 26rpx;
}
.cart-save {
  flex: 1;
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 26rpx;
}

/* ====== 弹窗 ====== */
.dialog-overlay {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(0,0,0,0.5);
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dialog-box {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  width: 80%;
}
.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 24rpx;
}
.dialog-input {
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}
.dialog-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}
.dialog-btn {
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}
.dialog-btn.cancel { background: #f5f5f5; color: #666; }
.dialog-btn.confirm { background: #07c160; color: #fff; }

/* ====== 通用 ====== */
.loading-more {
  text-align: center;
  padding: 20rpx;
  color: #999;
  font-size: 24rpx;
  grid-column: 1 / -1;
}
.empty-state {
  grid-column: 1 / -1;
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 30rpx;
}
