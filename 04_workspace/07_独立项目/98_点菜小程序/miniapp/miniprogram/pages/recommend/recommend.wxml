<!-- 条件推荐页 -->
<view class="page-recommend">

  <!-- 步骤指示器 -->
  <view class="steps-indicator">
    <view class="step {{step >= 1 ? 'active' : ''}} {{step === 1 ? 'current' : ''}}" data-step="1" bindtap="goStep">
      <text class="step-num">1</text>
      <text class="step-label">想吃啥</text>
    </view>
    <view class="step-line {{step >= 2 ? 'active' : ''}}"></view>
    <view class="step {{step >= 2 ? 'active' : ''}} {{step === 2 ? 'current' : ''}}" data-step="2" bindtap="goStep">
      <text class="step-num">2</text>
      <text class="step-label">天气</text>
    </view>
    <view class="step-line {{step >= 3 ? 'active' : ''}}"></view>
    <view class="step {{step >= 3 ? 'active' : ''}} {{step === 3 ? 'current' : ''}}" data-step="3" bindtap="goStep">
      <text class="step-num">3</text>
      <text class="step-label">身体</text>
    </view>
  </view>

  <!-- 步骤 1：想吃啥 -->
  <view class="step-panel" wx:if="{{step === 1}}">
    <text class="panel-title">🤔 今天想吃什么？</text>
    <view class="option-grid">
      <view class="option-card {{selected.craving === '肉' ? 'active' : ''}}"
        bindtap="select" data-key="craving" data-value="肉">
        <text class="option-icon">🥩</text>
        <text class="option-text">想吃肉</text>
      </view>
      <view class="option-card {{selected.craving === '素' ? 'active' : ''}}"
        bindtap="select" data-key="craving" data-value="素">
        <text class="option-icon">🥬</text>
        <text class="option-text">想吃素</text>
      </view>
      <view class="option-card {{selected.craving === '辣' ? 'active' : ''}}"
        bindtap="select" data-key="craving" data-value="辣">
        <text class="option-icon">🌶️</text>
        <text class="option-text">想吃辣</text>
      </view>
      <view class="option-card {{selected.craving === '清淡' ? 'active' : ''}}"
        bindtap="select" data-key="craving" data-value="清淡">
        <text class="option-icon">🥗</text>
        <text class="option-text">清淡</text>
      </view>
      <view class="option-card {{selected.craving === '汤' ? 'active' : ''}}"
        bindtap="select" data-key="craving" data-value="汤">
        <text class="option-icon">🍲</text>
        <text class="option-text">想喝汤</text>
      </view>
      <view class="option-card {{selected.craving === '快手' ? 'active' : ''}}"
        bindtap="select" data-key="craving" data-value="快手">
        <text class="option-icon">⚡</text>
        <text class="option-text">快手菜</text>
      </view>
      <view class="option-card {{selected.craving === '不挑' ? 'active' : ''}}"
        bindtap="select" data-key="craving" data-value="不挑">
        <text class="option-icon">🤷</text>
        <text class="option-text">不挑</text>
      </view>
    </view>
    <view class="step-nav">
      <button class="btn-next" disabled="{{!selected.craving}}" bindtap="nextStep">下一步</button>
    </view>
  </view>

  <!-- 步骤 2：天气 -->
  <view class="step-panel" wx:if="{{step === 2}}">
    <text class="panel-title">🌤️ 今天天气怎么样？</text>
    <view class="option-grid">
      <view class="option-card {{selected.weather === '大热天' ? 'active' : ''}}"
        bindtap="select" data-key="weather" data-value="大热天">
        <text class="option-icon">☀️</text>
        <text class="option-text">大热天</text>
      </view>
      <view class="option-card {{selected.weather === '大冷天' ? 'active' : ''}}"
        bindtap="select" data-key="weather" data-value="大冷天">
        <text class="option-icon">❄️</text>
        <text class="option-text">大冷天</text>
      </view>
      <view class="option-card {{selected.weather === '下雨' ? 'active' : ''}}"
        bindtap="select" data-key="weather" data-value="下雨">
        <text class="option-icon">🌧️</text>
        <text class="option-text">下雨</text>
      </view>
      <view class="option-card {{selected.weather === '干燥' ? 'active' : ''}}"
        bindtap="select" data-key="weather" data-value="干燥">
        <text class="option-icon">🏜️</text>
        <text class="option-text">干燥</text>
      </view>
      <view class="option-card {{selected.weather === '不限' ? 'active' : ''}}"
        bindtap="select" data-key="weather" data-value="不限">
        <text class="option-icon">🌿</text>
        <text class="option-text">不限</text>
      </view>
    </view>
    <view class="step-nav">
      <button class="btn-prev" bindtap="prevStep">上一步</button>
      <button class="btn-next" disabled="{{!selected.weather}}" bindtap="nextStep">下一步</button>
    </view>
  </view>

  <!-- 步骤 3：身体条件 -->
  <view class="step-panel" wx:if="{{step === 3}}">
    <text class="panel-title">💪 身体状况</text>
    <view class="option-grid">
      <view class="option-card {{selected.body === '没胃口' ? 'active' : ''}}"
        bindtap="select" data-key="body" data-value="没胃口">
        <text class="option-icon">😩</text>
        <text class="option-text">没胃口</text>
      </view>
      <view class="option-card {{selected.body === '减肥' ? 'active' : ''}}"
        bindtap="select" data-key="body" data-value="减肥">
        <text class="option-icon">🏃</text>
        <text class="option-text">减肥</text>
      </view>
      <view class="option-card {{selected.body === '上火' ? 'active' : ''}}"
        bindtap="select" data-key="body" data-value="上火">
        <text class="option-icon">🔥</text>
        <text class="option-text">上火</text>
      </view>
      <view class="option-card {{selected.body === '感冒' ? 'active' : ''}}"
        bindtap="select" data-key="body" data-value="感冒">
        <text class="option-icon">🤧</text>
        <text class="option-text">感冒了</text>
      </view>
      <view class="option-card {{selected.body === '运动后' ? 'active' : ''}}"
        bindtap="select" data-key="body" data-value="运动后">
        <text class="option-icon">💪</text>
        <text class="option-text">运动后</text>
      </view>
      <view class="option-card {{selected.body === '小孩' ? 'active' : ''}}"
        bindtap="select" data-key="body" data-value="小孩">
        <text class="option-icon">👶</text>
        <text class="option-text">小孩吃</text>
      </view>
      <view class="option-card {{selected.body === '不限' ? 'active' : ''}}"
        bindtap="select" data-key="body" data-value="不限">
        <text class="option-icon">👍</text>
        <text class="option-text">不限</text>
      </view>
    </view>
    <view class="step-nav">
      <button class="btn-prev" bindtap="prevStep">上一步</button>
      <button class="btn-recommend" disabled="{{!selected.body}}" bindtap="doRecommend" wx:if="{{!loading}}">🎯 推荐！</button>
      <button class="btn-recommend" wx:if="{{loading}}">🤔 推荐中...</button>
    </view>
  </view>

  <!-- 推荐结果 -->
  <view class="result-section" wx:if="{{showResult && dishes.length > 0}}">
    <text class="result-title">🍽️ 推荐结果</text>
    <text class="result-reason">{{reason}}</text>

    <view class="dish-list">
      <view class="dish-card" wx:for="{{dishes}}" wx:key="index"
        data-id="{{item._id}}" bindtap="goDetail">
        <text class="dish-name">{{item.name}}</text>
        <view class="dish-tags">
          <text class="tag tag-green" wx:if="{{item.isMeat}}">荤</text>
          <text class="tag tag-orange" wx:if="{{!item.isMeat}}">素</text>
          <text class="tag tag-blue" wx:for="{{item.meal_type || []}}" wx:key="*this">{{item}}</text>
          <text class="tag tag-purple" wx:for="{{item.taste || []}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="dish-meta">
          <text wx:if="{{item.calories}}">{{item.calories}}大卡</text>
          <text wx:if="{{item.cook_time}}">{{item.cook_time}}分钟</text>
        </view>
      </view>
    </view>

    <view class="result-actions">
      <button class="btn-retry" bindtap="doRecommend">🔄 换一批</button>
      <button class="btn-back" bindtap="reset">重新选择</button>
    </view>
  </view>

  <!-- 没有结果 -->
  <view class="empty-section" wx:if="{{showResult && dishes.length === 0}}">
    <text>😅 没有找到合适的菜</text>
    <text class="empty-hint">试试放宽条件</text>
    <button class="btn-back" bindtap="reset">重新选择</button>
  </view>
</view>
