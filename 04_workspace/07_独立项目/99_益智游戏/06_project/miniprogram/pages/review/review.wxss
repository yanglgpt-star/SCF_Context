.page-container {
  min-height: 100vh;
  padding: 40rpx;
}

.loading-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120rpx;
  color: #999;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #999;
}

.review-item {
  margin-bottom: 24rpx;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.child-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3436;
}

.task-time {
  font-size: 22rpx;
  color: #999;
}

.review-task {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3436;
  margin-bottom: 16rpx;
}

.media-row {
  font-size: 26rpx;
  color: #FF9A76;
  padding: 12rpx 0;
  margin-bottom: 16rpx;
}

.action-row {
  display: flex;
  gap: 20rpx;
}

.btn-approve,
.btn-reject {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  border: none;
  font-weight: 600;
}

.btn-approve {
  background: #E8F5E9;
  color: #2E7D32;
}

.btn-reject {
  background: #FFEBEE;
  color: #C62828;
}

.back-section {
  margin-top: 40rpx;
  display: flex;
  justify-content: center;
}
