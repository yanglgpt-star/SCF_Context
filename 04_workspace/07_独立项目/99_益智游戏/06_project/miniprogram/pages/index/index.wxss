.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

/* 角色区 */
.character-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.greeting-text {
  font-size: 48rpx;
  color: #2D3436;
  margin-top: 16rpx;
  font-weight: 700;
}

/* 加载中 */
.loading-tip {
  margin: 60rpx 0;
}

.loading-text {
  font-size: 32rpx;
  color: #999;
}

/* 空状态/错误 */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 60rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 今日任务预览 */
.task-preview {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.task-preview:active {
  transform: scale(0.98);
}

.preview-emoji {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9A76, #FF6B6B);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.preview-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.preview-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3436;
  line-height: 1.3;
}

.preview-stars {
  font-size: 22rpx;
}

/* 开始按钮 */
.action-section {
  margin-top: 60rpx;
  width: 100%;
  display: flex;
  justify-content: center;
}

.start-btn {
  width: 360rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: linear-gradient(135deg, #FF9A76, #FF6B6B);
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 107, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.start-btn:active {
  transform: scale(0.95);
}

.start-btn-icon {
  font-size: 48rpx;
}

.start-btn-text {
  font-size: 40rpx;
}

/* 底部导航 */
.bottom-nav {
  position: fixed;
  bottom: 40rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 80rpx;
}

.nav-item {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-item:active {
  transform: scale(0.9);
}

.nav-icon {
  font-size: 44rpx;
}

.home-indicator {
  background: linear-gradient(135deg, #FF9A76, #FF6B6B);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.3);
}
