.page-container {
  min-height: 100vh;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.big-icon {
  font-size: 120rpx;
  margin: 40rpx 0 16rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2D3436;
  text-align: center;
  margin-bottom: 32rpx;
}

.upload-card {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-area {
  width: 100%;
  min-height: 300rpx;
  border: 4rpx dashed #ddd;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.upload-area:active {
  border-color: #FF9A76;
  background: #FFF8F5;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.upload-icon {
  font-size: 80rpx;
}

.upload-hint {
  font-size: 28rpx;
  color: #999;
}

.preview-image {
  width: 100%;
  height: 300rpx;
  object-fit: cover;
}

.upload-btn {
  width: 60%;
}

.record-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.record-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9A76, #FF6B6B);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  box-shadow: 0 12rpx 40rpx rgba(255, 107, 107, 0.4);
}

.record-btn:active {
  transform: scale(0.95);
}

.record-btn.recording {
  animation: recordPulse 0.6s ease infinite alternate;
}

@keyframes recordPulse {
  0% { transform: scale(1); box-shadow: 0 12rpx 40rpx rgba(255, 107, 107, 0.4); }
  100% { transform: scale(1.05); box-shadow: 0 16rpx 56rpx rgba(255, 107, 107, 0.5); }
}

.record-label {
  font-size: 28rpx;
  color: #666;
  margin-top: 24rpx;
  font-weight: 500;
}

.record-duration {
  font-size: 24rpx;
  color: #FF9A76;
  margin-top: 12rpx;
}

.confirm-card {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 60rpx 0;
}

.confirm-text {
  font-size: 32rpx;
  color: #666;
  line-height: 1.6;
}

.action-section {
  margin-top: 60rpx;
  display: flex;
  justify-content: center;
}

.submit-btn {
  width: 360rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background: linear-gradient(135deg, #27AE60, #2ECC71);
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(39, 174, 96, 0.4);
}

.submit-btn:active {
  transform: scale(0.95);
}

.submit-btn[disabled] {
  opacity: 0.5;
}
