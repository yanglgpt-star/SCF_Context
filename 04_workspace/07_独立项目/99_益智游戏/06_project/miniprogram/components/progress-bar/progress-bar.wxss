.progress-container {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-bg {
  flex: 1;
  height: 100%;
  background: #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF9A76, #FF6B6B);
  border-radius: 12rpx;
  transition: width 0.5s ease;
}

.progress-text {
  font-size: 22rpx;
  color: #999;
  min-width: 60rpx;
  text-align: right;
}
