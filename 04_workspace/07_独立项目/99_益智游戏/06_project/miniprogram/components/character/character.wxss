.character-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
}

.character-avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9A76, #FF6B6B);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 96rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 107, 0.3);
  transition: transform 0.3s;
}

.character-avatar.happy {
  animation: bounce 0.6s ease infinite alternate;
}

.character-avatar.celebrate {
  animation: celebrate 0.5s ease infinite alternate;
}

.character-avatar.thinking {
  animation: tilt 1s ease infinite alternate;
}

@keyframes bounce {
  from { transform: translateY(0); }
  to { transform: translateY(-20rpx); }
}

@keyframes celebrate {
  from { transform: scale(1) rotate(0deg); }
  to { transform: scale(1.1) rotate(10deg); }
}

@keyframes tilt {
  from { transform: rotate(0deg); }
  to { transform: rotate(15deg); }
}
