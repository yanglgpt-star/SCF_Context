<view class="safe-page dice-page device-{{deviceType}}"><view class="header capsule-safe"><button class="back" bindtap="back">‹</button><view><view class="title">骰子游戏</view><view class="round">第 {{round}} 个 / {{total}}</view></view></view><view class="game-area"><view class="dice-side card"><view class="dice-row"><view class="die {{rolling?'rolling':''}}">{{leftFace}}</view><view class="plus">＋</view><view class="die {{rolling?'rolling':''}}">{{rightFace}}</view></view><button class="roll" bindtap="roll" disabled="{{rolling}}">🎲 掷骰子</button></view><view class="answer-side"><view class="feedback">{{feedback}}</view><view class="answers" wx:if="{{showAnswers}}"><button wx:for="{{options}}" wx:key="*this" data-value="{{item}}" bindtap="choose">{{item}}</button></view></view></view></view><view class="complete-mask device-{{deviceType}}" wx:if="{{completed}}"><view class="complete card"><view class="big">🎲</view><view class="complete-title">骰子游戏完成啦！</view><view class="complete-text">没有输赢，你认真数数就很棒</view><button class="primary" bindtap="home">回到学习乐园</button><button class="secondary" bindtap="again">再玩一组</button></view></view><orientation-guard/><rest-overlay/>
