.dice-page{min-height:100vh;overflow-y:auto}.header{display:flex;align-items:center;gap:22rpx}.back{width:90rpx;height:90rpx;padding:0;border-radius:30rpx;background:#fff9;color:#554d62;font-size:54rpx}.title{font-size:38rpx;font-weight:800}.round{color:#77707e;font-size:23rpx}.game-area{height:calc(100vh - 150rpx);display:grid;grid-template-columns:65% 1fr;gap:32rpx;padding-bottom:35rpx}.dice-side{display:flex;flex-direction:column;align-items:center;justify-content:center}.dice-row{display:flex;align-items:center;gap:35rpx}.die{font-family:serif;font-size:210rpx;line-height:1;color:#66557e}.die.rolling{animation:roll .2s linear infinite}.plus{font-size:70rpx;font-weight:800}.roll{min-width:420rpx;min-height:110rpx;margin-top:30rpx;border-radius:34rpx;background:#75649b;color:#fff;font-size:36rpx;font-weight:800}.answer-side{display:flex;flex-direction:column;justify-content:center}.feedback{min-height:100rpx;text-align:center;color:#655d6d;font-size:30rpx;font-weight:700;line-height:1.5}.answers{display:grid;gap:18rpx}.answers button{min-height:120rpx;border-radius:34rpx;background:#fff;color:#514a62;font-size:54rpx;font-weight:800}.complete-mask{position:fixed;z-index:100;inset:0;display:flex;align-items:center;justify-content:center;background:#39334475}.complete{width:720rpx;max-width:60vw;padding:45rpx;text-align:center;box-sizing:border-box}.big{font-size:82rpx}.complete-title{font-size:40rpx;font-weight:800}.complete-text{margin:14rpx 0 28rpx;color:#776f7d;font-size:27rpx}.complete .secondary{margin-top:15rpx}@keyframes roll{50%{transform:rotate(12deg) scale(1.06)}}
