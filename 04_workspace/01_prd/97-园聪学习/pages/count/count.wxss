.count-page{min-height:100vh;overflow-y:auto}.header{display:flex;align-items:center;gap:22rpx}.back{width:90rpx;height:90rpx;padding:0;border-radius:30rpx;background:#fff9;color:#554d62;font-size:54rpx}.title{font-size:38rpx;font-weight:800}.round{margin-top:3rpx;color:#77707e;font-size:23rpx}.content{height:calc(100vh - 155rpx);display:grid;grid-template-columns:68% 1fr;gap:34rpx;padding-bottom:35rpx}.object-card{display:flex;min-height:0;flex-direction:column;padding:30rpx}.tip{text-align:center;color:#6d6475;font-size:28rpx}.objects{flex:1;display:flex;align-content:center;align-items:center;justify-content:center;flex-wrap:wrap;gap:22rpx}.object{width:120rpx;height:120rpx;padding:0;border-radius:38rpx;background:#fff9;font-size:68rpx;transition:.2s}.object.tapped{opacity:.36;transform:scale(.84)}.answer-side{display:flex;flex-direction:column;justify-content:center}.feedback{min-height:90rpx;text-align:center;color:#655d6d;font-size:31rpx;font-weight:700}.answers{display:grid;grid-template-columns:1fr;gap:18rpx}.answers button{min-height:120rpx;border-radius:34rpx;background:#fff;color:#514a62;font-size:54rpx;font-weight:800}.waiting{text-align:center;font-size:90rpx;opacity:.45}.complete-mask{position:fixed;z-index:100;inset:0;display:flex;align-items:center;justify-content:center;background:#39334475}.complete{width:720rpx;max-width:60vw;padding:45rpx;text-align:center;box-sizing:border-box}.big{font-size:85rpx}.complete-title{font-size:42rpx;font-weight:800}.complete-text{margin:15rpx 0 30rpx;color:#776f7d;font-size:27rpx}.complete .secondary{margin-top:15rpx}
