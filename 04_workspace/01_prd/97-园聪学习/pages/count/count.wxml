<view class="safe-page count-page device-{{deviceType}}"><view class="header capsule-safe"><button class="back" bindtap="back">‹</button><view><view class="title">点数练习</view><view class="round">第 {{round}} 个 / {{total}}</view></view></view><view class="content"><view class="object-card card"><view class="tip">点一个，数一个</view><view class="objects {{objectSizeClass}}"><button wx:for="{{objects}}" wx:key="id" class="object {{item.tapped?'tapped':''}}" data-id="{{item.id}}" bindtap="tapObject" disabled="{{item.tapped}}">{{objectEmoji}}</button></view></view><view class="answer-side"><view class="feedback">{{feedback}}</view><view class="answers" wx:if="{{showOptions}}"><button wx:for="{{options}}" wx:key="*this" data-value="{{item}}" bindtap="choose">{{item}}</button></view><view class="waiting" wx:else>👆</view></view></view></view>
<view class="complete-mask device-{{deviceType}}" wx:if="{{completed}}"><view class="complete card"><view class="big">🌼</view><view class="complete-title">今天数得很认真！</view><view class="complete-text">现在看看远处，让眼睛休息一下</view><button class="primary" bindtap="home">回到学习乐园</button><button class="secondary" bindtap="again">再玩一组</button></view></view>
<orientation-guard/><rest-overlay/>
