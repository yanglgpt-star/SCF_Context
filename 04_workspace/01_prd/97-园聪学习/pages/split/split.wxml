<view class="safe-page split-page device-{{deviceType}}"><view class="header capsule-safe"><button class="back" bindtap="back">‹</button><view class="title">积木分一分</view><view class="target">今天分数字 <text>{{target}}</text></view><view class="round">{{round}} / {{total}}</view></view><view class="source-zone"><view class="feedback">{{feedback}}</view><view class="source-blocks"><view wx:for="{{source}}" wx:key="id" class="block c{{item.color}} {{draggingId===item.id?'dragging':''}}" style="{{draggingId===item.id?dragStyle:''}}" data-id="{{item.id}}" bindtouchstart="dragStart" catchtouchmove="dragMove" bindtouchend="dragEnd">🧱</view></view></view><view class="baskets"><view class="basket left-basket"><view class="basket-title">左边 <text>{{left.length}}</text></view><view class="basket-blocks"><view wx:for="{{left}}" wx:key="id" class="block c{{item.color}}" style="{{draggingId===item.id?dragStyle:''}}" data-id="{{item.id}}" bindtouchstart="dragStart" catchtouchmove="dragMove" bindtouchend="dragEnd">🧱</view></view></view><view class="plus">＋</view><view class="basket right-basket"><view class="basket-title">右边 <text>{{right.length}}</text></view><view class="basket-blocks"><view wx:for="{{right}}" wx:key="id" class="block c{{item.color}}" style="{{draggingId===item.id?dragStyle:''}}" data-id="{{item.id}}" bindtouchstart="dragStart" catchtouchmove="dragMove" bindtouchend="dragEnd">🧱</view></view></view></view></view>
<view class="complete-mask device-{{deviceType}}" wx:if="{{completed}}"><view class="complete card"><view class="big">⭐</view><view class="complete-title">你找到了好多种分法！</view><view class="complete-text">拿真实积木也试一试吧</view><button class="primary" bindtap="home">回到学习乐园</button><button class="secondary" bindtap="again">再分一组</button></view></view><orientation-guard/><rest-overlay/>
