.parent-page{min-height:100vh;display:grid;grid-template-columns:1fr 1fr;gap:20rpx;padding-bottom:45rpx}.intro{grid-column:1/-1;display:flex;align-items:center;gap:18rpx}.back{width:78rpx;height:78rpx;padding:0;border-radius:25rpx;background:#fff9;font-size:44rpx}.intro-icon{width:78rpx;height:78rpx;display:flex;align-items:center;justify-content:center;border-radius:27rpx;background:#fff;font-size:42rpx}.title{font-size:36rpx;font-weight:800}.intro .muted{font-size:22rpx}.stats{display:grid;grid-template-columns:1fr 1fr;gap:15rpx}.stat{padding:22rpx;text-align:center;color:#756f7b;font-size:22rpx}.stat text{display:block;color:#524a61;font-size:42rpx;font-weight:800}.report,.settings{padding:26rpx}.section-title{margin-bottom:18rpx;font-size:28rpx;font-weight:750}.metrics{display:grid;grid-template-columns:1fr 1fr;text-align:center}.metrics text{display:block;color:#68578a;font-size:40rpx;font-weight:800}.metrics label{color:#756f7b;font-size:21rpx}.operation-metrics{display:flex;justify-content:space-around;margin-top:18rpx;padding:14rpx;border-radius:20rpx;background:#f5f1f6;font-size:21rpx}.advice{margin-top:15rpx;padding:17rpx;border-radius:21rpx;background:#f0ebf3;font-size:22rpx;line-height:1.5}.setting-row{min-height:72rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #7771}.daily-label{margin:18rpx 0 12rpx}.daily-options{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.daily-button{min-height:68rpx;padding:0;border-radius:21rpx;background:#f0ebf3;font-size:22rpx}.daily-button.selected{background:#75649b;color:#fff}.privacy{grid-column:1/-1;text-align:center;color:#817b87;font-size:20rpx}.clear{grid-column:1/-1;background:transparent;color:#8b5d61;font-size:23rpx}.mask{position:fixed;z-index:10;inset:0;display:flex;align-items:center;justify-content:center;padding:40rpx;background:#39334466}.confirm{width:680rpx;max-width:60vw;padding:38rpx;text-align:center;box-sizing:border-box}.confirm-title{font-size:33rpx;font-weight:750}.danger{min-height:82rpx;margin:25rpx 0 12rpx;border-radius:26rpx;background:#91676b;color:#fff}
