.rest-mask{position:fixed;z-index:9000;inset:0;display:flex;align-items:center;justify-content:center;padding:60rpx;background:#3d3847a8;box-sizing:border-box}.rest-card{width:760rpx;max-width:75vw;padding:55rpx;border-radius:46rpx;background:#faf5ed;text-align:center;color:#514a62;box-sizing:border-box}.eyes{font-size:100rpx}.title{margin-top:15rpx;font-size:48rpx;font-weight:800}.text{margin:18rpx 0 35rpx;color:#756e7b;font-size:30rpx}.finish,.parent{width:100%;min-height:100rpx;border:0;border-radius:30rpx;font-size:32rpx;font-weight:700;white-space:nowrap}.finish{background:#75649b;color:#fff}.parent{margin-top:18rpx;background:#ece6ef;color:#61556f}.parent.pressing{opacity:.5}.rest-mask.phone{padding:10px 100px 10px 12px}.phone .rest-card{width:420px;max-width:58vw;padding:12px 16px;border-radius:16px}.phone .eyes{font-size:28px;line-height:1}.phone .title{margin-top:3px;font-size:18px}.phone .text{margin:4px 0 9px;font-size:13px}.phone .finish,.phone .parent{min-height:42px;border-radius:12px;font-size:14px}.phone .parent{margin-top:6px}
