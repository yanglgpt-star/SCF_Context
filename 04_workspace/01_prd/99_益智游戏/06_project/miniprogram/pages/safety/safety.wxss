.page-container {
  min-height: 100vh;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
}

.safety-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.safety-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.safety-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2D3436;
  margin-bottom: 16rpx;
}

.safety-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.rules-card {
  background: #FFF3E0;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.rule-item:last-child {
  margin-bottom: 0;
}

.rule-num {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rule-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.5;
}

.agree-section {
  margin-top: 40rpx;
  padding: 0 24rpx;
}

.agree-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.action-section {
  margin-top: 60rpx;
  display: flex;
  justify-content: center;
}
