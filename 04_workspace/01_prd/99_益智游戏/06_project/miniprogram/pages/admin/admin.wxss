.page-container {
  min-height: 100vh;
  padding: 40rpx;
}

.login-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.lock-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2D3436;
  margin-bottom: 40rpx;
}

.password-input {
  width: 400rpx;
  height: 80rpx;
  border: 2rpx solid #ddd;
  border-radius: 16rpx;
  text-align: center;
  font-size: 36rpx;
  margin-bottom: 32rpx;
}

.admin-stats-row {
  display: flex;
  justify-content: space-around;
}

.admin-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.admin-stat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #FF6B6B;
}

.admin-stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.menu-list {
  margin-top: 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-info {
  flex: 1;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3436;
}

.menu-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
}

.logout-section {
  margin-top: 60rpx;
  display: flex;
  justify-content: center;
}

/* 孩子管理 */
.children-card {
  margin-top: 24rpx;
}

.children-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.children-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
}

.children-add-btn {
  font-size: 26rpx;
  color: #FF6B6B;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border: 2rpx solid #FF6B6B;
  border-radius: 12rpx;
}

.add-child-form {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.add-child-input {
  flex: 1;
  height: 72rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.btn-small {
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  min-width: 160rpx;
  border-radius: 12rpx;
}

.empty-children {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 24rpx;
}

.children-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.child-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
  transition: background 0.2s;
}

.child-item:active {
  background: #f5f5f5;
}

.child-active {
  background: #FFF0F0;
  border: 2rpx solid #FF6B6B;
}

.child-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9A76, #FF6B6B);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.child-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.child-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3436;
}

.child-stars {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.child-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FF6B6B;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
