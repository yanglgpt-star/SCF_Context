.page-upload {
  padding: 30rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.upload-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.upload-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.upload-sub {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

.stats-section {
  display: flex;
  justify-content: space-around;
  margin-bottom: 30rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #07c160;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.action-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.btn-primary {
  flex: 1;
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 30rpx;
}

.btn-secondary {
  background: #fff;
  color: #666;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 30rpx;
}

.progress-section {
  margin-bottom: 30rpx;
}

.progress-bar-wrap {
  height: 12rpx;
  background: #e0e0e0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #07c160, #10b981);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
  text-align: center;
}

.log-section {
  background: #1a1a2e;
  border-radius: 12rpx;
  padding: 20rpx;
  max-height: 600rpx;
  font-family: monospace;
  font-size: 22rpx;
}

.log-entry {
  margin-bottom: 8rpx;
}

.log-entry.info .log-msg { color: #60a5fa; }
.log-entry.success .log-msg { color: #34d399; }
.log-entry.error .log-msg { color: #f87171; }
.log-entry.warn .log-msg { color: #fbbf24; }
