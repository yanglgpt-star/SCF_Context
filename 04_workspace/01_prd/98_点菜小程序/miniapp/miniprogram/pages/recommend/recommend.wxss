.page-recommend {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

/* 步骤指示器 */
.steps-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0 40rpx;
}
.step {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e0e0e0;
  color: #999;
  text-align: center;
  line-height: 48rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.step.active .step-num {
  background: #07c160;
  color: #fff;
}
.step.current .step-num {
  box-shadow: 0 0 0 4rpx rgba(7, 193, 96, 0.3);
}
.step-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}
.step.active .step-label { color: #07c160; }
.step-line {
  width: 60rpx;
  height: 4rpx;
  background: #e0e0e0;
  margin: 0 16rpx 36rpx;
}
.step-line.active { background: #07c160; }

/* 步骤面板 */
.step-panel { margin-bottom: 30rpx; }
.panel-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  display: block;
  text-align: center;
  margin-bottom: 30rpx;
}
.option-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
}
.option-card {
  background: #fff;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  transition: all 0.2s;
}
.option-card.active {
  border-color: #07c160;
  background: #f0fff4;
}
.option-icon {
  font-size: 44rpx;
  display: block;
  margin-bottom: 8rpx;
}
.option-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 导航按钮 */
.step-nav {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}
.btn-next, .btn-recommend, .btn-retry {
  flex: 1;
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
}
.btn-next[disabled], .btn-recommend[disabled] {
  background: #ccc;
  color: #fff;
}
.btn-prev, .btn-back {
  background: #fff;
  color: #666;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 30rpx;
  flex: 0 0 180rpx;
}

/* 结果区域 */
.result-section {
  margin-top: 20rpx;
}
.result-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}
.result-reason {
  font-size: 26rpx;
  color: #888;
  display: block;
  margin-bottom: 20rpx;
  line-height: 1.6;
}
.dish-list { margin-bottom: 24rpx; }
.dish-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
}
.dish-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}
.dish-tags { margin-bottom: 8rpx; }
.dish-meta {
  font-size: 24rpx;
  color: #999;
}
.result-actions {
  display: flex;
  gap: 20rpx;
}

/* 空状态 */
.empty-section {
  text-align: center;
  padding: 80rpx 0;
  font-size: 32rpx;
  color: #999;
}
.empty-hint {
  font-size: 26rpx;
  color: #bbb;
  display: block;
  margin-top: 12rpx;
  margin-bottom: 30rpx;
}
