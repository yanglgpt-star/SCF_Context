## 1.代采业务中心

### 1.1采购协议详情表

```text
CREATE TABLE `fa_purchase_agreement` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '主键',
  `agreement_name` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL COMMENT '协议名称',
  `agreement_no` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL COMMENT '协议唯一编号',
  `agent_purchase_amount` decimal(12,2) DEFAULT NULL COMMENT '代采总额',
  `client_id` bigint DEFAULT NULL COMMENT '委托方id',
  `client_name` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '委托方名称',
  `pay_company_id` bigint NOT NULL COMMENT '代采方id',
  `pay_company_name` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '代采方名称',
  `supplier_id` bigint NOT NULL COMMENT '供应商id',
  `supplier_name` varchar(200) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '供应商名称',
  `goods_start_date` date DEFAULT NULL COMMENT '提货开始日期',
  `goods_deadline_date` date DEFAULT NULL COMMENT '提货截止日期',
  `business_type` int DEFAULT NULL COMMENT '业务模式',
  `daily_service_rate` decimal(10,2) DEFAULT NULL COMMENT '每日服务费率（小数形式）',
  `deposit_rate` decimal(5,2) DEFAULT NULL COMMENT '保证金百分比，如12.50表示12.5%',
  `deposit_latest_payment_date` date DEFAULT NULL COMMENT '保证金最晚付款日期',
  `deposit_amount` decimal(12,2) DEFAULT NULL COMMENT '保证金金额',
  `agreement_status` int DEFAULT NULL COMMENT '协议状态（1.保存2.待签署合同3.待交保证金4.生效5.执行中6.已结清7.已违约） ',
  `contract_status` int DEFAULT NULL COMMENT '合同状态（1.未上传2.已上传）',
  `deleted` tinyint DEFAULT '0' COMMENT '删除状态',
  `create_by` bigint DEFAULT '0' COMMENT '创建人',
  `create_time` datetime DEFAULT NULL COMMENT '创建时间',
  `update_by` bigint DEFAULT '0' COMMENT '修改人',
  `update_time` datetime DEFAULT NULL COMMENT '修改时间',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_agreement_no` (`agreement_no`)
) ENGINE=InnoDB AUTO_INCREMENT=102 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='采购协议详情表';



```

